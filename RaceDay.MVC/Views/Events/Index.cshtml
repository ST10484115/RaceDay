
@model List<RaceDay.MVC.Models.Events.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Manage Events</h1>
            <p class="text-muted">Create and manage your RaceDay events.</p>
        </div>

        <a asp-action="Create" class="btn btn-dark">
            + Create Event
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <h4>No events created yet</h4>
                <p class="text-muted">
                    Start by creating your first racing event.
                </p>
                <a asp-action="Create" class="btn btn-dark">
                    Create Your First Event
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Distance</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var raceEvent in Model)
                    {
                        <tr>
                            <td>
                                <strong>@raceEvent.EventName</strong>
                                <br />
                                <small class="text-muted">
                                    @raceEvent.Description
                                </small>
                            </td>

                            <td>
                                @raceEvent.EventDate.ToString("dd MMM yyyy")
                            </td>

                            <td>@raceEvent.DistanceKm km</td>

                            <td>@raceEvent.EventType</td>

                            <td>
                                <span class="badge bg-info text-dark">
                                    @raceEvent.Status
                                </span>
                            </td>

                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@raceEvent.EventId"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@raceEvent.EventId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this event?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
