@model RaceDay.MVC.Models.Events.EventViewModel

@{
    ViewData["Title"] = "Edit Event";

    var locations = ViewBag.Locations as
        List<RaceDay.MVC.Models.Events.LocationViewModel>
        ?? new List<RaceDay.MVC.Models.Events.LocationViewModel>();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="mb-4">
                <h1 class="fw-bold">Edit Event</h1>
                <p class="text-muted">
                    Update your RaceDay event details.
                </p>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <form asp-action="Edit"
                          asp-route-id="@Model.EventId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="EventId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="EventName" class="form-label">
                                Event Name
                            </label>
                            <input asp-for="EventName" class="form-control" />
                            <span asp-validation-for="EventName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                Description
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDate" class="form-label">
                                Event Date and Time
                            </label>
                            <input asp-for="EventDate"
                                   type="datetime-local"
                                   class="form-control" />
                            <span asp-validation-for="EventDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LocationId" class="form-label">
                                Event Location
                            </label>

                            <select asp-for="LocationId" class="form-select">
                                <option value="">Select a location</option>

                                @foreach (var location in locations)
                                {
                                    <option value="@location.LocationId">
                                        @location.LocationName - @location.City
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="LocationId"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DistanceKm" class="form-label">
                                Distance (KM)
                            </label>
                            <input asp-for="DistanceKm"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   max="9999.99"
                                   class="form-control" />
                            <span asp-validation-for="DistanceKm"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventType" class="form-label">
                                Event Type
                            </label>
                            <select asp-for="EventType" class="form-select">
                                <option value="Run">Run</option>
                                <option value="Walk">Walk</option>
                                <option value="Cycle">Cycle</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Status" class="form-label">
                                Event Status
                            </label>
                            <select asp-for="Status" class="form-select">
                                <option value="Upcoming">Upcoming</option>
                                <option value="Active">Active</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-dark">
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
