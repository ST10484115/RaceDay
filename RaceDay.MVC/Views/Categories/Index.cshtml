@model List<RaceDay.MVC.Models.Events.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
    var eventId = (int)ViewBag.EventId;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Categories</h2>
            <p class="text-muted">Manage age groups, distances and entry fees.</p>
        </div>

        <a asp-action="Create"
           asp-route-eventId="@eventId"
           class="btn btn-primary">
            + Add Category
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No categories have been added to this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Category</th>
                        <th>Age Group</th>
                        <th>Distance</th>
                        <th>Entry Fee</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>@category.AgeGroup</td>
                            <td>@category.DistanceKm km</td>
                            <td>R @category.EntryFee.ToString("N2")</td>
                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@category.CategoryId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this category?');">

                                    <input type="hidden"
                                           name="id"
                                           value="@category.CategoryId" />

                                    <input type="hidden"
                                           name="eventId"
                                           value="@eventId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Back to Events
    </a>
</div>